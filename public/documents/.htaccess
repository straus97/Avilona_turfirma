# NOV-PUBLIC-03A: редактируемые исходники (.doc/.docx) — не публичные загрузки.
# Опубликованные юридические PDF этим правилом не затрагиваются. Решение о
# публикации исходников принимает владелец (N-4); пока оно не принято, исходники
# сайта не отдают. Файлы не удалены и не изменены. robots.txt — не контроль доступа,
# поэтому закрытие сделано на уровне веб-сервера. Для nginx/другого сервера нужен
# эквивалент (см. docs/NOV-PUBLIC-03A) либо исключение файлов из релизного пакета.
<FilesMatch "(?i)\.docx?$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
